# Replace every CHANGE_ME value before starting the stack.
APP_PORT=8080
PMA_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

DB_NAME=crm
DB_USER=crm_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_EXPORTER_PASSWORD=CHANGE_ME_EXPORTER_PASSWORD

JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRE_MINUTES=60
JWT_REMEMBER_EXPIRE_DAYS=30
ADMIN_EMAIL=admin@crm-demo.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional password-reset email settings. For local testing use Mailpit.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=false
SMTP_USE_SSL=false
PASSWORD_RESET_TTL_MINUTES=20
PUBLIC_APP_URL=http://127.0.0.1:8080
MAILPIT_UI_PORT=8025

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_URL=http://localhost:3000
